{
    "name": "agavesoft/mailflow",
    "description": "Laravel SDK client for the Mailflow API",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/queue": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Agavesoft\\Mailflow\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Agavesoft\\Mailflow\\MailflowServiceProvider"
            ],
            "aliases": {
                "Mailflow": "Agavesoft\\Mailflow\\MailflowFacade"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
